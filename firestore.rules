rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /lessonProgress/{lessonId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
